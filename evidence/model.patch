diff --git a/core/stream/generation.go b/core/stream/generation.go
new file mode 100644
index 000000000..d0378e396
--- /dev/null
+++ b/core/stream/generation.go
@@ -0,0 +1,127 @@
+package stream
+
+import (
+	"context"
+	"crypto/sha1"
+	"encoding/hex"
+	"fmt"
+
+	"github.com/navidrome/navidrome/consts"
+	"github.com/navidrome/navidrome/model"
+)
+
+// generationPrefix namespaces generation hashes from any other cache payload.
+const generationPrefix = "g"
+
+// TranscodingGeneration returns the content hash of one committed transcoding
+// configuration. It identifies the configuration's "generation": any change to
+// the command, target format or default bitrate produces a different
+// generation, which selects a different on-disk cache namespace and a different
+// decision snapshot.
+//
+// The hash is content-addressed on purpose: the generation switches exactly
+// when the committed DB row changes (or the built-in fallback changes in a new
+// release), while an unchanged profile keeps a stable generation and therefore
+// stable cache hits. A failed DB commit never publishes a new generation, so
+// players keep being served from the old configuration and old cache until the
+// new snapshot is durably committed.
+func TranscodingGeneration(t model.Transcoding) string {
+	h := sha1.New()
+	fmt.Fprintf(h, "%s\x00%s\x00%d", t.TargetFormat, t.Command, t.DefaultBitRate)
+	return generationPrefix + hex.EncodeToString(h.Sum(nil))
+}
+
+// defaultTranscodingFor returns the built-in transcoding definition for format.
+func defaultTranscodingFor(format string) (model.Transcoding, bool) {
+	for _, d := range consts.DefaultTranscodings {
+		if d.TargetFormat == format {
+			return model.Transcoding{
+				Name:           d.Name,
+				TargetFormat:   d.TargetFormat,
+				Command:        d.Command,
+				DefaultBitRate: d.DefaultBitRate,
+			}, true
+		}
+	}
+	return model.Transcoding{}, false
+}
+
+// EffectiveTranscoding resolves the committed transcoding snapshot for format:
+// the DB row when it defines a command, otherwise the built-in default for the
+// format. ok is false when no committed configuration can produce format.
+//
+// Every playback step (profile selection, the token snapshot and the ffmpeg
+// command launch) resolves through this function, so a playback always runs the
+// snapshot of one committed configuration.
+func EffectiveTranscoding(ctx context.Context, ds model.DataStore, format string) (model.Transcoding, bool) {
+	snapshot := model.Transcoding{TargetFormat: format}
+	if ds != nil {
+		if t, err := ds.Transcoding().FindByFormat(ctx, format); err == nil && t != nil {
+			snapshot = *t
+		}
+	}
+
+	if snapshot.Command == "" {
+		d, ok := defaultTranscodingFor(format)
+		if !ok {
+			return model.Transcoding{}, false
+		}
+		snapshot.TargetFormat = d.TargetFormat
+		snapshot.Command = d.Command
+		if snapshot.DefaultBitRate == 0 {
+			snapshot.DefaultBitRate = d.DefaultBitRate
+		}
+	}
+	return snapshot, true
+}
+
+// EffectiveGeneration resolves the committed snapshot for format and returns
+// its generation. ok is false when the format has no transcoding command.
+func EffectiveGeneration(ctx context.Context, ds model.DataStore, format string) (string, bool) {
+	t, ok := EffectiveTranscoding(ctx, ds, format)
+	if !ok {
+		return "", false
+	}
+	return TranscodingGeneration(t), true
+}
+
+// CurrentTranscodingGenerations returns the generations of every snapshot a
+// new playback can resolve to right now: committed DB rows (with the built-in
+// command fallback applied) and built-in defaults. The transcoding cache uses
+// it on startup to adopt only complete entries produced by a still-committed
+// generation.
+func CurrentTranscodingGenerations(ctx context.Context, ds model.DataStore) (map[string]struct{}, error) {
+	gens := map[string]struct{}{}
+
+	rows, err := ds.Transcoding().All(ctx)
+	if err != nil {
+		return nil, err
+	}
+	for i := range rows {
+		t := rows[i]
+		if t.Command == "" {
+			d, ok := defaultTranscodingFor(t.TargetFormat)
+			if !ok {
+				// No effective command for this row: no playback can resolve
+				// to it, so it has no current generation.
+				continue
+			}
+			t.Command = d.Command
+			if t.DefaultBitRate == 0 {
+				t.DefaultBitRate = d.DefaultBitRate
+			}
+		}
+		gens[TranscodingGeneration(t)] = struct{}{}
+	}
+
+	for _, d := range consts.DefaultTranscodings {
+		gens[TranscodingGeneration(model.Transcoding{
+			Name:           d.Name,
+			TargetFormat:   d.TargetFormat,
+			Command:        d.Command,
+			DefaultBitRate: d.DefaultBitRate,
+		})] = struct{}{}
+	}
+
+	return gens, nil
+}
diff --git a/core/stream/generation_test.go b/core/stream/generation_test.go
new file mode 100644
index 000000000..b135a173d
--- /dev/null
+++ b/core/stream/generation_test.go
@@ -0,0 +1,133 @@
+package stream
+
+import (
+	"context"
+
+	"github.com/navidrome/navidrome/consts"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/tests"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("Transcoding generations", func() {
+	var (
+		ds  *tests.MockDataStore
+		ctx context.Context
+	)
+
+	BeforeEach(func() {
+		ctx = context.Background()
+		ds = &tests.MockDataStore{MockedTranscoding: &tests.MockTranscodingRepo{}}
+	})
+
+	Describe("TranscodingGeneration", func() {
+		It("is stable for the same configuration", func() {
+			t := model.Transcoding{TargetFormat: "mp3", Command: "ffmpeg -f mp3", DefaultBitRate: 192}
+			Expect(TranscodingGeneration(t)).To(Equal(TranscodingGeneration(t)))
+			Expect(TranscodingGeneration(t)).To(HavePrefix(generationPrefix))
+		})
+
+		It("changes when the command changes", func() {
+			old := model.Transcoding{TargetFormat: "opus", Command: "ffmpeg -c:a libopus -b:a 96k", DefaultBitRate: 96}
+			new := old
+			new.Command = "ffmpeg -c:a libopus -b:a 128k -vbr on"
+			Expect(TranscodingGeneration(new)).NotTo(Equal(TranscodingGeneration(old)))
+		})
+
+		It("changes when the target format or default bitrate changes", func() {
+			base := model.Transcoding{TargetFormat: "mp3", Command: "ffmpeg", DefaultBitRate: 192}
+			format := base
+			format.TargetFormat = "opus"
+			bitrate := base
+			bitrate.DefaultBitRate = 320
+			Expect(TranscodingGeneration(format)).NotTo(Equal(TranscodingGeneration(base)))
+			Expect(TranscodingGeneration(bitrate)).NotTo(Equal(TranscodingGeneration(base)))
+		})
+
+		It("does not depend on the row id or display name", func() {
+			a := model.Transcoding{ID: "id-1", Name: "first", TargetFormat: "mp3", Command: "ffmpeg", DefaultBitRate: 192}
+			b := model.Transcoding{ID: "id-2", Name: "renamed", TargetFormat: "mp3", Command: "ffmpeg", DefaultBitRate: 192}
+			// A rename keeps the generation (and therefore all cache hits).
+			Expect(TranscodingGeneration(b)).To(Equal(TranscodingGeneration(a)))
+		})
+	})
+
+	Describe("EffectiveTranscoding", func() {
+		It("prefers a committed DB row with a command", func() {
+			ds.MockedTranscoding = &tests.MockTranscodingRepo{Data: map[string]*model.Transcoding{
+				"mp3": {ID: "custom", TargetFormat: "mp3", Command: "custom-command", DefaultBitRate: 320},
+			}}
+			t, ok := EffectiveTranscoding(ctx, ds, "mp3")
+			Expect(ok).To(BeTrue())
+			Expect(t.ID).To(Equal("custom"))
+			Expect(t.Command).To(Equal("custom-command"))
+		})
+
+		It("falls back to the built-in command when the DB row has none", func() {
+			ds.MockedTranscoding = &tests.MockTranscodingRepo{Data: map[string]*model.Transcoding{
+				"mp3": {ID: "row", TargetFormat: "mp3", DefaultBitRate: 160},
+			}}
+			t, ok := EffectiveTranscoding(ctx, ds, "mp3")
+			Expect(ok).To(BeTrue())
+			var builtin string
+			for _, d := range consts.DefaultTranscodings {
+				if d.TargetFormat == "mp3" {
+					builtin = d.Command
+				}
+			}
+			Expect(t.Command).To(Equal(builtin))
+			Expect(t.DefaultBitRate).To(Equal(160))
+		})
+
+		It("uses the built-in default when no row exists", func() {
+			t, ok := EffectiveTranscoding(ctx, ds, "mp3")
+			Expect(ok).To(BeTrue())
+			Expect(t.Command).ToNot(BeEmpty())
+		})
+
+		It("reports false for an unknown format", func() {
+			_, ok := EffectiveTranscoding(ctx, ds, "wma-pro")
+			Expect(ok).To(BeFalse())
+		})
+
+		It("resolves identically on repeated calls (stable committed snapshot)", func() {
+			g1, ok1 := EffectiveGeneration(ctx, ds, "mp3")
+			g2, ok2 := EffectiveGeneration(ctx, ds, "mp3")
+			Expect(ok1).To(BeTrue())
+			Expect(ok2).To(BeTrue())
+			Expect(g1).To(Equal(g2))
+		})
+	})
+
+	Describe("CurrentTranscodingGenerations", func() {
+		It("includes built-in default generations", func() {
+			gens, err := CurrentTranscodingGenerations(ctx, ds)
+			Expect(err).ToNot(HaveOccurred())
+			for _, d := range consts.DefaultTranscodings {
+				Expect(gens).To(HaveKey(TranscodingGeneration(model.Transcoding{
+					Name: d.Name, TargetFormat: d.TargetFormat, Command: d.Command, DefaultBitRate: d.DefaultBitRate,
+				})))
+			}
+		})
+
+		It("includes effective generations of committed rows", func() {
+			custom := model.Transcoding{ID: "c1", Name: "custom mp3", TargetFormat: "mp3", Command: "custom-command", DefaultBitRate: 320}
+			ds.MockedTranscoding = &tests.MockTranscodingRepo{Data: map[string]*model.Transcoding{"mp3": &custom}}
+			gens, err := CurrentTranscodingGenerations(ctx, ds)
+			Expect(err).ToNot(HaveOccurred())
+			Expect(gens).To(HaveKey(TranscodingGeneration(custom)))
+		})
+
+		It("applies the built-in command fallback to rows before hashing", func() {
+			ds.MockedTranscoding = &tests.MockTranscodingRepo{Data: map[string]*model.Transcoding{
+				"mp3": {ID: "row", TargetFormat: "mp3", DefaultBitRate: 160},
+			}}
+			gens, err := CurrentTranscodingGenerations(ctx, ds)
+			Expect(err).ToNot(HaveOccurred())
+			effective, ok := EffectiveTranscoding(ctx, ds, "mp3")
+			Expect(ok).To(BeTrue())
+			Expect(gens).To(HaveKey(TranscodingGeneration(effective)))
+		})
+	})
+})
